# /etc/deploy-window/env — mode 0600, owned by root, never in a repository.
# Slack bot token (starts with xoxb-…)
DWA_SLACK_BOT_TOKEN=
# Slack app-level token with connections:write (starts with xapp-…)
DWA_SLACK_APP_TOKEN=
# Grafana service-account token
DWA_GRAFANA_TOKEN=
# Optional marker signing key (marker_key_env), 32 random bytes as hex
# DWA_MARKER_KEY=
